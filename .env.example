# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are safe to expose client-side (Firebase web config
# and Stripe Payment Links are not secrets) — see netlify.toml's
# SECRETS_SCAN_OMIT_KEYS for why Netlify's build won't flag them.

# Stripe Payment Links (test mode until launch)
NEXT_PUBLIC_STRIPE_LINK_BASE=
NEXT_PUBLIC_STRIPE_LINK_PORTAL=

# Firebase web config (Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
